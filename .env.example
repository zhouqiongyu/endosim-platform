# 扣子智能体配置
COZE_BOT_ID=7664215749598724138

# 方案 A：Coze OAuth Service（JWT）✅ 推荐
# 使用 RSA 私钥签名 JWT，向 Coze 换取短期 access_token
COZE_APP_ID=117678909106954240063
COZE_KID=你的公钥ID
COZE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
在此处粘贴你的 RSA 私钥
-----END PRIVATE KEY-----

# 方案 B：后端托管 PAT（备用）
# 配置后 server.js 会优先返回 PAT，跳过 OAuth 流程
# COZE_PAT_TOKEN=pat_xxxxxxxxxxxxxxxx

# 服务端口（本地运行时）
PORT=3000
